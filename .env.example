# GEMINI_API_KEY: Required for server-side Gemini AI classification and discovery extraction.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DENIO_ENV: Mandatory explicit environment selector ("staging" or "production").
# Server startup fails closed if DENIO_ENV is missing/invalid or active credentials are incomplete.
# Never falls back to legacy SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY.
DENIO_ENV="staging"

# --- DENIO-STAGING Supabase Project (Server-Only) ---
# When DENIO_ENV=staging, the server reads `.env.staging` / process env and requires all 3 variables:
SUPABASE_STAGING_URL=""
SUPABASE_STAGING_SERVICE_ROLE_KEY=""
# Mandatory project reference ID; startup fails closed unless it matches the Staging URL hostname:
SUPABASE_STAGING_PROJECT_ID=""

# --- DENIO-PRODUCTION Supabase Project (Server-Only) ---
# When DENIO_ENV=production, the server reads `.env.production` / process env and requires all 3 variables:
SUPABASE_PRODUCTION_URL=""
SUPABASE_PRODUCTION_SERVICE_ROLE_KEY=""
# Mandatory project reference ID; startup fails closed unless it matches the Production URL hostname:
SUPABASE_PRODUCTION_PROJECT_ID=""

# SEARCH_ENGINE_API_KEY: Tavily search provider key for live Search Engine Discovery.
SEARCH_ENGINE_API_KEY=""
